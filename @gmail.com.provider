[pop3]
Protocol=0
MailServer=pop.<domain>
SMTPServer=smtp.<domain>
SMTPAUTH=1
SMTPAUTHMODE=8
SMTPPort=587
IMAP4Port=993
POP3Port=995
SSLSMTP=1
SSLIMAP=1
SSLPOP=1
POP3Auth=4
IMAPAuth=4
OnlineTrashName=[Gmail]/Trash
OnlineDraftName=[Gmail]/Drafts
OnlineSentName=[Gmail]/Sent Mail
OnlineTrash=1
OnlineDraft=1
OnlineSent=1
UserID=recent:<id>@<domain>

[imap4]
Protocol=1
MailServer=imap.<domain>
SMTPServer=smtp.<domain>
SMTPAUTH=1
SMTPAUTHMODE=8
SMTPPort=587
IMAP4Port=993
POP3Port=995
SSLSMTP=1
SSLIMAP=1
SSLPOP=1
POP3Auth=4
IMAPAuth=4
IMAPDir=[Gmail]
OnlineTrashName=[Gmail]/Trash
OnlineDraftName=[Gmail]/Drafts
OnlineSentName=[Gmail]/Sent Mail
OnlineTrash=1
OnlineDraft=1
OnlineSent=1
UserID=<id>@<domain>
UseIMAPIDLE=1
UseIMAPCompress=1
UseQUOTA=1
AutoFolderNames=1
