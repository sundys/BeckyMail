[pop3]
Protocol=0
MailServer=pop.mail.<domain>
SMTPServer=smtp.mail.<domain>
SSLSMTP=1
SSLIMAP=1
SSLPOP=1
POP3Port=995
IMAP4Port=993
SMTPPort=465
SMTPAUTH=1
UserID=<id>

[imap4]
Protocol=0
MailServer=pop.mail.<domain>
SMTPServer=smtp.mail.<domain>
SSLSMTP=1
SSLIMAP=1
SSLPOP=1
POP3Port=995
IMAP4Port=993
SMTPPort=465
SMTPAUTH=1
UserID=<id>
