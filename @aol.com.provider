[pop3]
Protocol=0
MailServer=pop.aol.com
SMTPServer=smtp.aol.com
SMTPAUTH=1
SMTPPort=587
POP3Port=110
UserID=<address>

[imap4]
Protocol=1
MailServer=imap.aol.com
SMTPServer=smtp.aol.com
SMTPAUTH=1
SMTPPort=587
IMAP4Port=143
OnlineTrashName=Trash
OnlineDraftName=Drafts
OnlineSentName=Sent
OnlineTrash=1
OnlineDraft=1
OnlineSent=1
UserID=<address>

