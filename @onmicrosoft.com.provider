[pop3]
Protocol=0
MailServer=outlook.office365.com
SMTPServer=smtp.office365.com
SMTPAUTH=1
SMTPAUTHMODE=8
SMTPPort=587
IMAP4Port=993
POP3Port=995
SSLSMTP=1
SSLIMAP=1
SSLPOP=1
POP3Auth=4
IMAPAuth=4
OnlineTrashName=Deleted Items
OnlineDraftName=Drafts
OnlineSentName=Sent Items
OnlineTrash=1
OnlineDraft=1
OnlineSent=1
UserID=<address>
OAUTHPROVRECV=1
OAUTHPROVSEND=1

[imap4]
Protocol=1
MailServer=outlook.office365.com
SMTPServer=smtp.office365.com
SMTPAUTH=1
SMTPAUTHMODE=8
SMTPPort=587
IMAP4Port=993
POP3Port=995
SSLSMTP=1
SSLIMAP=1
SSLPOP=1
POP3Auth=4
IMAPAuth=4
OnlineTrashName=Deleted Items
OnlineDraftName=Drafts
OnlineSentName=Sent Items
OnlineTrash=1
OnlineDraft=1
OnlineSent=1
UserID=<address>
UseIMAPIDLE=1
UseIMAPCompress=1
UseQUOTA=1
AutoFolderNames=1
OAUTHPROVRECV=1
OAUTHPROVSEND=1
