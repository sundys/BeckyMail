[pop3]
Protocol=0
UserID=<id>@<domain>
MailServer=pop3.live.com
SMTPServer=smtp.live.com
SMTPAUTH=1
SMTPPort=587
POP3Port=995
IMAP4Port=993
SSLSMTP=1
SSLPOP=1
SSLIMAP=1
OnlineTrashName=Deleted
OnlineDraftName=Drafts
OnlineDraft=1
OnlineSent=1

[imap4]
Protocol=1
UserID=<id>@<domain>
MailServer=imap-mail.outlook.com
SMTPServer=smtp-mail.outlook.com
SMTPAUTH=1
SMTPPort=587
POP3Port=995
IMAP4Port=993
SSLSMTP=1
SSLIMAP=1
SSLPOP=1
OnlineTrashName=Deleted
OnlineDraftName=Drafts
OnlineDraft=1
OnlineSent=1
