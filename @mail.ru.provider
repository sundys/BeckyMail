[pop3]
Protocol=0
MailServer=pop.mail.ru
SMTPServer=smtp.mail.ru
SSLSMTP=1
SSLIMAP=1
SSLPOP=1
POP3Port=995
IMAP4Port=993
SMTPPort=465
SMTPAUTH=1
UserID=<id>@<domain>

[imap4]
Protocol=0
MailServer=imap.mail.ru
SMTPServer=smtp.mail.ru
SSLSMTP=1
SSLIMAP=1
IMAP4Port=993
SMTPPort=465
SMTPAUTH=1
UserID=<id>@<domain>